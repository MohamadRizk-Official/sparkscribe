# Copy to .env.local for local development (never commit .env.local).
# Both values are public by design: the URL and the sb_publishable_ key are meant for browsers.
# Never put the Supabase secret / service-role key in a NEXT_PUBLIC_ (or VITE_) variable.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Summary / Ask / Insights (server only: read by the api/ functions, never sent to the browser).
# Never give this a NEXT_PUBLIC_ or VITE_ prefix.
ANTHROPIC_API_KEY=
# Optional: model overrides (default claude-haiku-5-5)
# AI_MODEL_ASK=claude-sonnet-5-5
# Local development without a key: deterministic stand-in, ignored in production
# AI_PROVIDER=mock

# Settings > Delete account. Turn on (=1) only in the release that applies
# supabase/proposed/*_account_deletion.sql; public build flag, not a secret.
# VITE_ACCOUNT_DELETION=1
# Server secret for recording real AI cost in the usage ledger (supabase/proposed/*_ai_usage_limits.sql).
# Falls back to BILLING_DB_SECRET. Server only: never NEXT_PUBLIC_ or VITE_.
# AI_DB_SECRET=
# Set AI_LIMITS_REQUIRED=1 once that migration is applied: a missing ledger function then refuses AI requests
# instead of running them unmetered (any other ledger failure always refuses). Server only.
# AI_LIMITS_REQUIRED=1
# Emergency only (rollback plan): skip AI usage checks entirely; logged on use. Never leave on.
# AI_LIMITS_DISABLED=1

# ---- Billing (Stripe). Payments stay OFF until all of these are deliberately set. Server only unless VITE_. ----
# BILLING_DB_SECRET=            # server secret for the billing_* and ai_settle database functions (hash stored in the DB)
# STRIPE_SECRET_KEY=            # sk_test_… on Preview; sk_live_… only in Production, only after approval
# STRIPE_WEBHOOK_SECRET=        # whsec_… for /api/stripe-webhook (signature checked on every event)
# STRIPE_PLUS_PRICE_ID= STRIPE_PRO_PRICE_ID= STRIPE_PORTAL_CONFIGURATION_ID=
# BILLING_PAYMENTS_ENABLED=1    # without it Checkout refuses before any Stripe call ("Nothing was charged")
# BILLING_LIVE_APPROVED=1       # additionally required for a LIVE key: the only way real money can be taken
# APP_URL=https://sparkscribe.ai  # where Stripe returns users; needed once the app runs on its own domain
# VITE_PAID_PLANS=1             # public build flag: show Upgrade buttons on Pricing (the server still decides)
# VITE_REQUIRE_ACCOUNT=1        # public build flag: require sign-in to transcribe (off: on-device use stays open)
